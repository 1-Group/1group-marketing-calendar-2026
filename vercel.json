{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://workagent.1-group.ai"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/|export\\.html).*)",
      "destination": "https://attribution.1-group.ai/dashboard/calendar",
      "permanent": false
    }
  ]
}
